---
title: PlantPlan · Diagrama de clases
---
classDiagram
    direction TB

    class User {
        -Long id
        -String name
        -String email
        -String password
        -Role role
        -List~Garden~ gardens
        -List~CropSheet~ cropSheets
    }

    class Garden {
        -Long id
        -String name
        -String location
        -Double latitude
        -Double longitude
        -User user
        -List~Crop~ crops
    }

    class CropSheet {
        -Long id
        -String name
        -String variety
        -Month sowingStartMonth
        -Month sowingEndMonth
        -Month transplantStartMonth
        -Month transplantEndMonth
        -Month harvestStartMonth
        -Month harvestEndMonth
        -Integer wateringFrequencyDays
        -SunExposure sunExposure
        -String notes
        -User user
        -List~Seed~ seeds
        -List~Seedling~ seedlings
        -List~Crop~ crops
    }

    class Seed {
        -Long id
        -Integer quantity
        -String notes
        -CropSheet cropSheet
    }

    class Seedling {
        -Long id
        -Integer sownQuantity
        -LocalDate sowingDate
        -Integer transplantedQuantity
        -LocalDate transplantDate
        -String notes
        -CropSheet cropSheet
    }

    class Crop {
        -Long id
        -Integer initialQuantity
        -LocalDate transplantDate
        -Integer harvestedQuantity
        -LocalDate endDate
        -String notes
        -CropSheet cropSheet
        -Garden garden
    }

    class Reminder {
        -Long id
        -ReminderType type
        -ReminderStatus status
        -LocalDate scheduledDate
        -LocalDateTime completedAt
        -String title
        -String description
        -User user
        -CropSheet cropSheet
        -Seed seed
        -Seedling seedling
        -Crop crop
        -Garden garden
    }

    class Role {
        <<enumeration>>
        USER
        ADMIN
    }

    class SunExposure {
        <<enumeration>>
        FULL_SUN
        PARTIAL_SUN
        PARTIAL_SHADE
        SHADE
    }

    class ReminderType {
        <<enumeration>>
        SOWING_START
        SOWING_END_WARNING
        TRANSPLANT_START
        TRANSPLANT_END_WARNING
        WATERING
    }

    class ReminderStatus {
        <<enumeration>>
        PENDING
        COMPLETED
        CANCELLED
    }

    User "1" -- "0..*" Garden
    User "1" -- "0..*" CropSheet
    Garden "1" -- "0..*" Crop
    CropSheet "1" -- "0..*" Seed
    CropSheet "1" -- "0..*" Seedling
    CropSheet "1" -- "0..*" Crop

    User "1" <-- "0..*" Reminder
    Garden "0..1" <-- "0..*" Reminder
    CropSheet "0..1" <-- "0..*" Reminder
    Seed "0..1" <-- "0..*" Reminder
    Seedling "0..1" <-- "0..*" Reminder
    Crop "0..1" <-- "0..*" Reminder

    User ..> Role
    CropSheet ..> SunExposure
    Reminder ..> ReminderType
    Reminder ..> ReminderStatus
